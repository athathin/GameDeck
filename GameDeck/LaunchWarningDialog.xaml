<Window x:Class="GameDeck.Views.LaunchWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}">

    <StackPanel Margin="28,24,28,22" Width="380">
        <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button x:Name="LaunchButton" Content="Launch" IsDefault="True" Click="LaunchButton_Click"
                    Style="{StaticResource DialogButton}" Background="#8037FE" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
