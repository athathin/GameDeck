<Window x:Class="GameDeck.Views.LaunchWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#171A21">

    <StackPanel Margin="28,24,28,22" Width="380">
        <TextBlock x:Name="HeadingText" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Foreground="#C5CBD6" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                    Style="{StaticResource DialogButton}" Background="#2A2F3A" Foreground="White"/>
            <Button x:Name="LaunchButton" Content="Launch" IsDefault="True" Click="LaunchButton_Click"
                    Style="{StaticResource DialogButton}" Background="#8037FE" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
