<UserControl x:Class="GameDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Built like Big Picture's settings: the sections on the left, the chosen section's settings on the right as cards
         (SettingSwitch / SettingCard in App.xaml). Shown in its own window (SettingsWindow). -->
    <UserControl.Resources>
        <!-- a button on a card: a card has the pill buttons' own color (RaisedBg), so these get the text boxes' darker field color -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- the sections: the content names the panel shown (ShowSection) -->
        <Border Background="{DynamicResource PanelBg}" Padding="0,26,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Settings" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"
                           Margin="28,0,0,18"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SectionNav">
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="General" Tag="&#xE713;" IsChecked="True" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Library" Tag="&#xE8F1;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Appearance" Tag="&#xE790;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Controller" Tag="&#xE7FC;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Sound" Tag="&#xE767;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Screenshots" Tag="&#xE722;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="Quick launch" Tag="&#xE765;" Checked="SectionNav_Checked"/>
                        <RadioButton Style="{StaticResource SettingsNavItem}" Content="System" Tag="&#xE770;" Checked="SectionNav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- the chosen section: its title, then its settings -->
        <DockPanel Grid.Column="1" Margin="36,26,12,0">
            <TextBlock x:Name="SectionTitle" DockPanel.Dock="Top" Text="General" Foreground="{DynamicResource TextPrimary}" FontSize="28"
                       FontWeight="SemiBold" Margin="0,0,0,0"/>

            <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,20,24">

                    <!-- ======================= General ======================= -->
                    <StackPanel x:Name="GeneralSection">
                        <TextBlock Text="Starting GameDeck" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <CheckBox x:Name="StartupCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed">
                            <TextBlock Text="Launch GameDeck when Windows starts" Style="{StaticResource SettingTitle}"/>
                        </CheckBox>

                        <!-- only shown while "Launch GameDeck when Windows starts" is on -->
                        <StackPanel x:Name="StartMinimizedPanel">
                            <CheckBox x:Name="StartMinimizedCheckBox" Style="{StaticResource SettingSwitch}"
                                      Checked="StartMinimizedCheckBox_Changed" Unchecked="StartMinimizedCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Start minimized to the system tray" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="When this is off, the GameDeck window opens when Windows starts." Style="{StaticResource SettingNote}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <CheckBox x:Name="StartInBigPictureCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="StartInBigPictureCheckBox_Changed" Unchecked="StartInBigPictureCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Open GameDeck in Big Picture mode" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Like a console: GameDeck opens full screen, ready for the controller. Exiting Big Picture shows the library. With &quot;Launch GameDeck when Windows starts&quot; on and &quot;minimized&quot; off, the PC starts straight into Big Picture."/>
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="Closing and playing" Style="{StaticResource SettingHeading}"/>
                        <CheckBox x:Name="TrayCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="TrayCheckBox_Changed" Unchecked="TrayCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Minimize to the system tray when closing GameDeck" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="When this is off, closing the window closes GameDeck completely." Style="{StaticResource SettingNote}"/>
                                <TextBlock x:Name="AskHint" Text="Not chosen yet: GameDeck asks you every time you close it."
                                           Style="{StaticResource SettingNote}" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="MinimizeOnLaunchCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="MinimizeOnLaunchCheckBox_Changed" Unchecked="MinimizeOnLaunchCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Minimize GameDeck to the system tray when a game starts" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Applies to games you start from GameDeck. Open GameDeck again from the tray icon." Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="LaunchToastCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="LaunchToastCheckBox_Changed" Unchecked="LaunchToastCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Show a notice when a game starts" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="A small &quot;Game on!&quot; in the corner of the screen." Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="LeftOffCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="LeftOffCheckBox_Changed" Unchecked="LeftOffCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Ask where I left off when a game closes" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="After a session of 10 minutes or more. Your answer shows on the game's page and in Continue playing; you can always skip it."
                                           Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="WeeklyRecapCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="WeeklyRecapCheckBox_Changed" Unchecked="WeeklyRecapCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Show a weekly recap" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Once a week, a notice with the week before: how long you played, on how many days, and your most played game. Only games started from GameDeck."
                                           Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Remind me to take a break" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="A notice in the corner after every so long in one session of a game started from GameDeck."
                                           Style="{StaticResource SettingNote}"/>
                                <!-- one radio button per choice of SettingsService.BreakReminderChoices, made in code -->
                                <WrapPanel x:Name="BreakChoices" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= Library ======================= -->
                    <StackPanel x:Name="LibrarySection" Visibility="Collapsed">
                        <TextBlock Text="Games" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Find games" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Scan your installed launchers for games, or add a game yourself by choosing its .exe."
                                           Style="{StaticResource SettingNote}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="ScanButton" Content="Scan for games" Style="{StaticResource CardButton}" Margin="0,0,8,0"
                                            Click="ScanButton_Click"/>
                                    <Button Content="Add games" Style="{StaticResource CardButton}" Margin="0,0,8,0" Click="AddGamesButton_Click"/>
                                    <Button Content="Find duplicates" Style="{StaticResource CardButton}" Margin="0" Click="DuplicatesButton_Click"
                                            ToolTip="Finds the same game listed twice (for example through two launchers) so you can merge them"/>
                                </WrapPanel>
                                <TextBlock x:Name="GamesStatus" Foreground="{DynamicResource Accent}" FontSize="13" TextWrapping="Wrap"
                                           Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Playtime and covers" Style="{StaticResource SettingHeading}"/>
                        <CheckBox x:Name="ImportPlaytimeCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="ImportPlaytimeCheckBox_Changed" Unchecked="ImportPlaytimeCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Include playtime from your launchers" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Games show the hours Steam, GOG Galaxy (also for the launchers connected to it: Ubisoft, Xbox, EA...) or the itch.io app counted, when they are more than GameDeck's, including the time before you used GameDeck. Read from their files on this PC; nothing goes online."/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="OnlineCoversCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="OnlineCoversCheckBox_Changed" Unchecked="OnlineCoversCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Download cover art from the internet" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Fetches each game's cover from Steam (and Epic for Epic games) once and keeps it on this PC. Game names are sent to Steam to find the right cover."/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="When this is off, GameDeck doesn't download covers or look up game names. Covers already downloaded stay; other games show a placeholder."/>
                            </StackPanel>
                        </CheckBox>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="SteamGridDB key (optional)" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="For games that no other source has a cover for. Create a free account on steamgriddb.com, copy your API key from its preferences and paste it here. The key is saved on this PC, and the names of the games without a cover are sent to steamgriddb.com. Leave it empty to not use it."/>
                                <TextBox x:Name="GridKeyBox" Style="{StaticResource DarkTextBox}" Width="420" HorizontalAlignment="Left"
                                         Background="{DynamicResource AppBg}" Margin="0,12,0,0" LostFocus="GridKeyBox_LostFocus"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="IGDB keys (optional)" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="For the games no store knows: their description, background art and cover from IGDB. The keys come from Twitch (IGDB belongs to it), not from the IGDB website. The keys are saved on this PC, and the names of the games are sent to IGDB. Leave them empty to not use it."/>
                                <!-- how to get the keys: Twitch's developer console, not igdb.com (which has no place for them) -->
                                <TextBlock Style="{StaticResource SettingNote}" Margin="0,10,0,0" LineHeight="20"
                                           Text="1. Click the button below: Twitch's developer console opens in your browser. Sign in with a Twitch account (a free one is fine).&#x0a;2. Twitch only lets you register an app once two-factor authentication is on: if it asks, turn it on in Twitch › Settings › Security and Privacy, then click the button again.&#x0a;3. Fill in the form: Name: anything (e.g. GameDeck plus a few numbers, it must be unique). OAuth Redirect URLs: http://localhost. Category: Application Integration. Client Type: Confidential. Then click Create.&#x0a;4. In the list of your applications, click Manage next to it. Copy the Client ID into the box below, then click New Secret and copy that into Client Secret."/>
                                <Button Content="Open Twitch's developer console" Style="{StaticResource CardButton}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Click="IgdbConsoleButton_Click"/>
                                <TextBlock Text="Client ID" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,12,0,4"/>
                                <TextBox x:Name="IgdbIdBox" Style="{StaticResource DarkTextBox}" Width="420" HorizontalAlignment="Left"
                                         Background="{DynamicResource AppBg}" LostFocus="IgdbKeys_LostFocus"/>
                                <TextBlock Text="Client Secret" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="IgdbSecretBox" Style="{StaticResource DarkPasswordBox}" Width="420" HorizontalAlignment="Left"
                                             Background="{DynamicResource AppBg}" LostFocus="IgdbKeys_LostFocus"/>
                                <TextBlock x:Name="IgdbStatus" Style="{StaticResource SettingNote}" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= Appearance ======================= -->
                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <TextBlock Text="Colors" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SettingTitle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton x:Name="DarkThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                                 Content="Dark" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="LightThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                                 Content="Light" Margin="32,0,0,0" Checked="ThemeRadio_Checked"/>
                                    <RadioButton x:Name="SystemThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                                 Content="Follow Windows" Margin="32,0,0,0" Checked="ThemeRadio_Checked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Accent color" Style="{StaticResource SettingTitle}"/>
                                <!-- one round swatch per ThemeService.Accents, made in code; the chosen one has a ring -->
                                <WrapPanel x:Name="AccentChoices" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Big Picture" Style="{StaticResource SettingHeading}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Size" Style="{StaticResource SettingTitle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton x:Name="ScaleNormalRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                                 Content="Normal" Checked="ScaleRadio_Checked"/>
                                    <RadioButton x:Name="ScaleLargeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                                 Content="Large" Margin="32,0,0,0" Checked="ScaleRadio_Checked"/>
                                    <RadioButton x:Name="ScaleHugeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                                 Content="Extra large (for a TV)" Margin="32,0,0,0" Checked="ScaleRadio_Checked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Screen saver" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="After that long without a button press, Big Picture fades to black with your game covers moving around: it protects OLED TVs from burn-in. Any button wakes it."/>
                                <!-- one radio button per choice of SettingsService.ScreenSaverChoices, made in code -->
                                <WrapPanel x:Name="ScreenSaverChoices" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= Controller ======================= -->
                    <StackPanel x:Name="ControllerSection" Visibility="Collapsed">
                        <TextBlock Text="Buttons" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <CheckBox x:Name="SwapButtonsCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="SwapButtonsCheckBox_Changed" Unchecked="SwapButtonsCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Confirm with B and go back with A" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Swaps the two buttons, like on a Nintendo controller." Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ControllerWakeCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="ControllerWakeCheckBox_Changed" Unchecked="ControllerWakeCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Open Big Picture mode from a controller" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Press the Home button (Xbox, PlayStation or Home button), or hold View + Menu (Back + Start) for a second, while GameDeck is in the tray. It never listens while a game from GameDeck is running or a full-screen app is in front."/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ControllerShortcutsCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="ControllerShortcutsCheckBox_Changed" Unchecked="ControllerShortcutsCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Controller shortcuts" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Hold Home and press a button: volume, songs, Alt-Tab, keyboard, screenshot. They also work during games (GameDeck only reads the controller). The full list: Big Picture › Power › Show Controller Shortcuts."/>
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="Battery" Style="{StaticResource SettingHeading}"/>
                        <CheckBox x:Name="LowBatteryCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="LowBatteryCheckBox_Changed" Unchecked="LowBatteryCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Warn when the controller's battery is low" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="A notice in the corner at 15% and at 5%, also during games. For Xbox controllers over Bluetooth (the battery Windows' Bluetooth settings show)."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!-- ======================= Sound ======================= -->
                    <StackPanel x:Name="SoundSection" Visibility="Collapsed">
                        <TextBlock Text="Big Picture sounds" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <CheckBox x:Name="NavSoundsCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="NavSoundsCheckBox_Changed" Unchecked="NavSoundsCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Play sounds in Big Picture mode" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="When moving, selecting, going back and starting a game." Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <!-- the sounds' volume: a slider that snaps to SettingsService.SoundVolumes, like the tile size slider -->
                                <Slider x:Name="SoundVolumeSlider" DockPanel.Dock="Right" Style="{StaticResource SettingSlider}" Width="220"
                                        VerticalAlignment="Center" Margin="20,0,0,0"
                                        IsEnabled="{Binding IsChecked, ElementName=NavSoundsCheckBox}"
                                        Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="1" ValueChanged="SoundVolumeSlider_ValueChanged"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Volume" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock x:Name="VolumeNote" Text="Each change plays a sample." Style="{StaticResource SettingNote}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= Screenshots ======================= -->
                    <StackPanel x:Name="ScreenshotsSection" Visibility="Collapsed">
                        <TextBlock Text="Where they're saved" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Screenshots taken with the controller (Home + RT) are saved in:" Style="{StaticResource SettingTitle}"/>
                                <TextBlock x:Name="ScreenshotFolderText" Style="{StaticResource SettingNote}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Choose folder…" Style="{StaticResource CardButton}" Margin="0,0,8,0"
                                            Click="ScreenshotFolderButton_Click"/>
                                    <Button x:Name="ScreenshotDefaultButton" Content="Use the default" Style="{StaticResource CardButton}" Margin="0"
                                            Click="ScreenshotDefaultButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= Quick launch ======================= -->
                    <StackPanel x:Name="QuicklaunchSection" Visibility="Collapsed">
                        <TextBlock Text="Start a game from anywhere" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <CheckBox x:Name="QuickLaunchCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="QuickLaunchCheckBox_Changed" Unchecked="QuickLaunchCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Open a quick launch box with a keyboard shortcut" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Works from anywhere, even while GameDeck is in the system tray. Type a few letters of a game and press Enter to start it."/>
                            </StackPanel>
                        </CheckBox>

                        <!-- only shown while quick launch is on -->
                        <Border x:Name="ShortcutPanel" Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="ShortcutButton" DockPanel.Dock="Right" Style="{StaticResource CardButton}" Margin="20,0,0,0" MinWidth="150"
                                            Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown"
                                            LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/>
                                    <TextBlock Text="Shortcut" Style="{StaticResource SettingTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="ShortcutHint" Style="{StaticResource SettingNote}" Margin="0,8,0,0"
                                           Text="Click the button, then press the keys you want. Use Ctrl or Alt (or both) together with another key. Press Esc to cancel."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================= System ======================= -->
                    <StackPanel x:Name="SystemSection" Visibility="Collapsed">
                        <TextBlock Text="Updates" Style="{StaticResource SettingHeading}" Margin="2,10,0,10"/>
                        <CheckBox x:Name="AutoUpdateCheckBox" Style="{StaticResource SettingSwitch}"
                                  Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed">
                            <StackPanel>
                                <TextBlock Text="Install updates automatically when GameDeck starts" Style="{StaticResource SettingTitle}"/>
                                <TextBlock x:Name="VersionText" Style="{StaticResource SettingNote}"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="Check now" Style="{StaticResource CardButton}"
                                            Margin="20,0,0,0" Click="CheckUpdatesButton_Click"/>
                                    <TextBlock Text="Check for updates" Style="{StaticResource SettingTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingNote}" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- a small donation button (PayPal, AppInfo.DonateUrl): opens the page in the browser -->
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Button x:Name="DonateButton" DockPanel.Dock="Right" Content="♥  Donate" Style="{StaticResource CardButton}"
                                        Margin="20,0,0,0" VerticalAlignment="Center" Click="DonateButton_Click"
                                        ToolTip="Opens PayPal in your browser"/>
                                <StackPanel>
                                    <TextBlock Text="Support GameDeck" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock x:Name="DonateText" Style="{StaticResource SettingNote}"
                                               Text="GameDeck is free. If you enjoy it, you can buy its maker a coffee through PayPal."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Backup" Style="{StaticResource SettingHeading}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Save your data to a file" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingNote}"
                                           Text="Your favorites, playtime, names, hidden games, categories, status, ratings, notes, launch options, launch routines and games you added yourself. Useful when moving to a new PC; the file stays wherever you save it."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Export backup" Style="{StaticResource CardButton}" Margin="0,0,8,0" Click="ExportButton_Click"/>
                                    <Button Content="Import backup" Style="{StaticResource CardButton}" Margin="0" Click="ImportButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Save a backup every day in a folder you choose" Style="{StaticResource SettingTitle}"/>
                                <TextBlock x:Name="BackupFolderText" Style="{StaticResource SettingNote}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Choose folder…" Style="{StaticResource CardButton}" Margin="0,0,8,0" Click="BackupFolderButton_Click"/>
                                    <Button x:Name="BackupOffButton" Content="Turn off" Style="{StaticResource CardButton}" Margin="0"
                                            Click="BackupOffButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Uninstall" Style="{StaticResource SettingHeading}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Uninstall GameDeck…" Style="{StaticResource CardButton}" Margin="20,0,0,0"
                                        VerticalAlignment="Center" Foreground="#FF6B6B" Click="UninstallButton_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Remove GameDeck from this PC completely" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Style="{StaticResource SettingNote}"
                                               Text="Removes GameDeck's program file. You choose whether to keep your library, favorites, playtime, categories, settings and covers, or delete them too. Your games are not touched."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
