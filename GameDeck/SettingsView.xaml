<UserControl x:Class="GameDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,0,8,0" MaxWidth="720" HorizontalAlignment="Left">

            <!-- title with a back button -->
            <DockPanel Margin="0,0,0,22">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource PillButton}" Margin="0,0,16,0" Padding="14,8"
                        FontSize="16" Click="BackButton_Click" ToolTip="Back to the library (Esc)">
                    <!-- the font draws the arrow 2 px below the middle of its line: lifted back to the middle of the box
                         (a render offset, so the button keeps its size) -->
                    <TextBlock Text="←">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-2"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="GAMES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               Text="Scan your installed launchers for games, or add a game yourself by choosing its .exe."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ScanButton" Content="Scan for games" Style="{StaticResource PillButton}" Margin="0"
                                Click="ScanButton_Click"/>
                        <Button Content="Add games" Style="{StaticResource PillButton}" Click="AddGamesButton_Click"/>
                        <Button Content="Find duplicates" Style="{StaticResource PillButton}" Click="DuplicatesButton_Click"
                                ToolTip="Finds the same game listed twice (for example through two launchers) so you can merge them"/>
                    </StackPanel>
                    <TextBlock x:Name="GamesStatus" Foreground="{DynamicResource Accent}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="GENERAL" Margin="2,26,0,8" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <CheckBox x:Name="StartupCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Launch GameDeck when Windows starts"
                              Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>

                    <!-- sub-option: only shown while "Launch GameDeck when Windows starts" is ticked -->
                    <StackPanel x:Name="StartMinimizedPanel">
                        <CheckBox x:Name="StartMinimizedCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="14"
                                  Margin="28,12,0,0" Content="Launch GameDeck minimized to the system tray"
                                  Checked="StartMinimizedCheckBox_Changed" Unchecked="StartMinimizedCheckBox_Changed"/>
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="56,5,0,0"
                                   Text="When this is off, the GameDeck window opens when Windows starts."/>
                    </StackPanel>

                    <CheckBox x:Name="StartInBigPictureCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" Margin="0,16,0,0"
                              Content="Open GameDeck in Big Picture mode"
                              Checked="StartInBigPictureCheckBox_Changed" Unchecked="StartInBigPictureCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Like a console: GameDeck opens full screen, ready for the controller. Exiting Big Picture shows this window. With &quot;Launch GameDeck when Windows starts&quot; on and &quot;minimized&quot; off, the PC starts straight into Big Picture."/>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <CheckBox x:Name="TrayCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Minimize to the system tray when closing GameDeck"
                              Checked="TrayCheckBox_Changed" Unchecked="TrayCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="When this is off, closing the window closes GameDeck completely."/>
                    <TextBlock x:Name="AskHint" Foreground="{DynamicResource Accent}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Not chosen yet: GameDeck asks you every time you close it."/>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <CheckBox x:Name="MinimizeOnLaunchCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Minimize GameDeck to the system tray when a game starts"
                              Checked="MinimizeOnLaunchCheckBox_Changed" Unchecked="MinimizeOnLaunchCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Applies to games you start from GameDeck. Open GameDeck again from the tray icon."/>

                    <CheckBox x:Name="LaunchToastCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" Margin="0,14,0,0"
                              Content="Show a notice in the corner when a game starts"
                              Checked="LaunchToastCheckBox_Changed" Unchecked="LaunchToastCheckBox_Changed"/>

                    <TextBlock Text="Remind me to take a break" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,18,0,0"/>
                    <!-- one radio button per choice of SettingsService.BreakReminderChoices, made in code -->
                    <StackPanel x:Name="BreakChoices" Orientation="Horizontal" Margin="0,10,0,0"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="A notice in the corner after every so long in one session of a game started from GameDeck."/>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <CheckBox x:Name="ImportPlaytimeCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Include playtime from your launchers"
                              Checked="ImportPlaytimeCheckBox_Changed" Unchecked="ImportPlaytimeCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,16"
                               Text="Games show the hours Steam, GOG Galaxy (also for the launchers connected to it: Ubisoft, Xbox, EA...) or the itch.io app counted, when they are more than GameDeck's, including the time before you used GameDeck. Read from their files on this PC; nothing goes online."/>

                    <CheckBox x:Name="OnlineCoversCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Download cover art from the internet"
                              Checked="OnlineCoversCheckBox_Changed" Unchecked="OnlineCoversCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Fetches each game's cover from Steam (and Epic for Epic games) once and keeps it on this PC. Game names are sent to Steam to find the right cover."/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="When this is off, GameDeck doesn't download covers or look up game names. Covers already downloaded stay; other games show a placeholder."/>

                    <TextBlock Text="SteamGridDB key (optional)" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,16,0,6"/>
                    <TextBox x:Name="GridKeyBox" Style="{StaticResource DarkTextBox}" MaxWidth="420" HorizontalAlignment="Left"
                             LostFocus="GridKeyBox_LostFocus"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="For games that no other source has a cover for. Create a free account on steamgriddb.com, copy your API key from its preferences and paste it here. The key is saved on this PC, and the names of the games without a cover are sent to steamgriddb.com. Leave it empty to not use it."/>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <CheckBox x:Name="AutoUpdateCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Install updates automatically when GameDeck starts"
                              Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"/>
                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left" Margin="28,14,0,0" Click="CheckUpdatesButton_Click"/>
                    <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap"
                               Margin="28,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="APPEARANCE" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <TextBlock Text="Theme" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="DarkThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                     Content="Dark" Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="LightThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                     Content="Light" Margin="32,0,0,0" Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="SystemThemeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="Theme"
                                     Content="Follow Windows" Margin="32,0,0,0" Checked="ThemeRadio_Checked"/>
                    </StackPanel>

                    <TextBlock Text="Accent color" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,22,0,0"/>
                    <!-- one round swatch per ThemeService.Accents, made in code; the chosen one has a ring -->
                    <StackPanel x:Name="AccentChoices" Orientation="Horizontal" Margin="0,10,0,0"/>

                    <TextBlock Text="Big Picture size" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,22,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="ScaleNormalRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                     Content="Normal" Checked="ScaleRadio_Checked"/>
                        <RadioButton x:Name="ScaleLargeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                     Content="Large" Margin="32,0,0,0" Checked="ScaleRadio_Checked"/>
                        <RadioButton x:Name="ScaleHugeRadio" Style="{StaticResource DarkRadioButton}" FontSize="15" GroupName="BigScale"
                                     Content="Extra large (for a TV)" Margin="32,0,0,0" Checked="ScaleRadio_Checked"/>
                    </StackPanel>

                    <TextBlock Text="Big Picture screen saver" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,22,0,0"/>
                    <!-- one radio button per choice of SettingsService.ScreenSaverChoices, made in code -->
                    <StackPanel x:Name="ScreenSaverChoices" Orientation="Horizontal" Margin="0,12,0,0"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="After that long without a button press, Big Picture fades to black with your game covers moving around: it protects OLED TVs from burn-in. Any button wakes it."/>
                </StackPanel>
            </Border>

            <TextBlock Text="QUICK LAUNCH" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <CheckBox x:Name="QuickLaunchCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Open a quick launch box with a keyboard shortcut"
                              Checked="QuickLaunchCheckBox_Changed" Unchecked="QuickLaunchCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Works from anywhere, even while GameDeck is in the system tray. Type a few letters of a game and press Enter to start it."/>

                    <StackPanel x:Name="ShortcutPanel" Margin="28,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shortcut" Foreground="{DynamicResource TextSecondary}" FontSize="14" VerticalAlignment="Center"/>
                            <Button x:Name="ShortcutButton" Style="{StaticResource PillButton}" Margin="16,0,0,0" MinWidth="150"
                                    Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown"
                                    LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/>
                        </StackPanel>
                        <TextBlock x:Name="ShortcutHint" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Click the button, then press the keys you want. Use Ctrl or Alt (or both) together with another key. Press Esc to cancel."/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <CheckBox x:Name="SwapButtonsCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" Margin="0,0,0,14"
                              Content="Confirm with B and go back with A (swap the two buttons)"
                              Checked="SwapButtonsCheckBox_Changed" Unchecked="SwapButtonsCheckBox_Changed"/>

                    <!-- (left-aligned, so it is only as wide as its text: the volume slider below takes that width) -->
                    <CheckBox x:Name="NavSoundsCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" HorizontalAlignment="Left"
                              Content="Play sounds in Big Picture mode (moving, selecting, going back, starting a game)"
                              Checked="NavSoundsCheckBox_Changed" Unchecked="NavSoundsCheckBox_Changed"/>

                    <!-- the sounds' volume: a slider that snaps to SettingsService.SoundVolumes, like the tile size slider -->
                    <Slider x:Name="SoundVolumeSlider" Style="{StaticResource SlimSlider}" HorizontalAlignment="Left" Margin="0,8,0,14"
                            Width="{Binding ActualWidth, ElementName=NavSoundsCheckBox}"
                            IsEnabled="{Binding IsChecked, ElementName=NavSoundsCheckBox}"
                            Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="1" ValueChanged="SoundVolumeSlider_ValueChanged"/>

                    <CheckBox x:Name="ControllerWakeCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15"
                              Content="Open Big Picture mode from a controller"
                              Checked="ControllerWakeCheckBox_Changed" Unchecked="ControllerWakeCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="Press the Home button (Xbox, PlayStation or Home button), or hold View + Menu (Back + Start) for a second, while GameDeck is in the tray. It never listens while a game from GameDeck is running or a full-screen app is in front."/>

                    <CheckBox x:Name="ControllerShortcutsCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" Margin="0,14,0,0"
                              Content="Controller shortcuts: hold Home and press a button (volume, songs, Alt-Tab, keyboard, screenshot)"
                              Checked="ControllerShortcutsCheckBox_Changed" Unchecked="ControllerShortcutsCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="They also work during games (GameDeck only reads the controller). The full list: Big Picture › Power › Show Controller Shortcuts."/>

                    <CheckBox x:Name="LowBatteryCheckBox" Style="{StaticResource DarkCheckBox}" FontSize="15" Margin="0,14,0,0"
                              Content="Warn when the controller's battery is low"
                              Checked="LowBatteryCheckBox_Changed" Unchecked="LowBatteryCheckBox_Changed"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="28,5,0,0"
                               Text="A notice in the corner at 15% and at 5%, also during games. For Xbox controllers over Bluetooth (the battery Windows' Bluetooth settings show)."/>

                </StackPanel>
            </Border>

            <TextBlock Text="SCREENSHOTS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               Text="Screenshots taken with the controller (Home + RT) are saved in:"/>
                    <TextBlock x:Name="ScreenshotFolderText" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Choose folder…" Style="{StaticResource PillButton}" Margin="0"
                                Click="ScreenshotFolderButton_Click"/>
                        <Button x:Name="ScreenshotDefaultButton" Content="Use the default" Style="{StaticResource PillButton}"
                                Click="ScreenshotDefaultButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="BACKUP" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               Text="Save your favorites, playtime, names, hidden games, categories, status, ratings, notes, launch options, launch routines and games you added yourself to a file, or restore them from one."/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Useful when moving to a new PC. The file stays wherever you save it."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Export backup" Style="{StaticResource PillButton}" Margin="0"
                                Click="ExportButton_Click"/>
                        <Button Content="Import backup" Style="{StaticResource PillButton}"
                                Click="ImportButton_Click"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource RaisedBg}" Margin="0,18"/>

                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               Text="Save a backup every day in a folder you choose"/>
                    <TextBlock x:Name="BackupFolderText" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Choose folder…" Style="{StaticResource PillButton}" Margin="0"
                                Click="BackupFolderButton_Click"/>
                        <Button x:Name="BackupOffButton" Content="Turn off" Style="{StaticResource PillButton}"
                                Click="BackupOffButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="UNINSTALL" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,8"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               Text="Remove GameDeck from this PC completely."/>
                    <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Removes GameDeck's program file. You choose whether to keep your library, favorites, playtime, categories, settings and covers, or delete them too. Your games are not touched."/>
                    <Button Content="Uninstall GameDeck…" Style="{StaticResource PillButton}" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Foreground="#FF6B6B" Click="UninstallButton_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
