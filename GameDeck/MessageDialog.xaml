<Window x:Class="GameDeck.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#171A21"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="28,24,28,22" Width="400">
        <TextBlock x:Name="HeadingText" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Foreground="#C5CBD6" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <!-- the buttons are added in code: the last one is the purple default, Esc picks the Cancel / No one -->
        <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0"/>
    </StackPanel>
</Window>
