<Window x:Class="GameDeck.Views.DuplicatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate games" Width="560" Height="560" MinHeight="320" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Duplicate games" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="These look like the same game listed more than once. Choose the entry to keep and merge: playtime, favorite and categories are combined into it, and the others are hidden (you can still find them with the &quot;Hidden games&quot; filter)."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="GroupList" Margin="0,0,10,0"/>
                <TextBlock x:Name="DoneText" Text="No duplicates left." Foreground="{DynamicResource TextMuted}" FontSize="14"
                           Margin="2,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" IsCancel="True" Style="{StaticResource DialogButton}"
                    Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>
    </Grid>
</Window>
