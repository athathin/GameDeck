<Window x:Class="GameDeck.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}">

    <StackPanel Margin="28,24,28,22">
        <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="PromptText" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,12"/>
        <TextBox x:Name="InputBox" Style="{StaticResource DarkTextBox}" MaxLength="30"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button x:Name="ConfirmButton" IsDefault="True" Click="ConfirmButton_Click"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource Accent}" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
