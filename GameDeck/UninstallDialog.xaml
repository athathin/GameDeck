<Window x:Class="GameDeck.Views.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="28,24,28,22" Width="460">
        <TextBlock Text="Uninstall GameDeck" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Your games are not touched. What should happen to GameDeck's own files?"/>

        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="16,14" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Keep my data" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Removes the program only. Your library, favorites, playtime, categories, settings and covers stay in %AppData%\GameDeck, so everything is back if you use GameDeck again."/>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Remove everything" Foreground="#FF6B6B" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Also deletes all of that data. Nothing of GameDeck is left on this PC. This can't be undone, so export a backup first if you might want it."/>
            </StackPanel>
        </Border>

        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Either way, the GameDeck program file, the &quot;start with Windows&quot; entry and the temporary files are removed."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}" MinWidth="80"/>
            <Button Content="Keep my data" Click="KeepButton_Click" Style="{StaticResource DialogButton}"
                    Background="#8037FE" Foreground="White" MinWidth="80"/>
            <Button Content="Remove everything" Click="RemoveAllButton_Click" Style="{StaticResource DialogButton}"
                    Background="#C0392B" Foreground="White" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
