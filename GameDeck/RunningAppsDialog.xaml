<Window x:Class="GameDeck.Views.RunningAppsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Running apps" Width="520" Height="480" MinHeight="300" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#171A21"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="AppItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2F3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8037FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Running apps" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="#C5CBD6" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Pick the apps to close before this game starts. Windows itself and game launchers aren't listed. Hold Ctrl to pick several."/>
        </StackPanel>

        <ListBox x:Name="AppList" Grid.Row="1" Margin="0,14,0,0" SelectionMode="Extended"
                 Background="#1E222B" BorderThickness="0" Padding="6"
                 ItemContainerStyle="{StaticResource AppItem}"
                 MouseDoubleClick="AppList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14"/>
                        <TextBlock Text="{Binding Title}" Foreground="#8A91A0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    Background="#2A2F3A" Foreground="White"/>
            <Button Content="Add" IsDefault="True" Click="AddButton_Click" Style="{StaticResource DialogButton}"
                    Background="#8037FE" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
