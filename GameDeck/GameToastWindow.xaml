<Window x:Class="GameDeck.Views.GameToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" Opacity="0"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <!-- the margin leaves room for the shadow, which the transparent window would otherwise clip -->
    <Border Margin="14" Width="330" Background="{DynamicResource AppBg}" CornerRadius="10" BorderBrush="#8037FE" BorderThickness="1"
            Padding="18,14,18,15" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeadlineText" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameText" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DetailText" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
