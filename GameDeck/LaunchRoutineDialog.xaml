<Window x:Class="GameDeck.Views.LaunchRoutineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch routine" Width="560" Height="720" MinHeight="420" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="AppItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RaisedBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,22,0,8"/>
        </Style>

        <Style x:Key="AppListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AppItem}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Steps GameDeck runs around this game. They only run when you start the game from GameDeck, not when you start it from another launcher."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" Margin="0,0,10,0">

                <!-- apps to open -->
                <TextBlock Text="OPEN THESE APPS BEFORE THE GAME" Style="{StaticResource FieldHeader}"/>
                <ListBox x:Name="StartList" Style="{StaticResource AppListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextPrimary}" FontSize="13" ToolTip="{Binding Path}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add app…" Style="{StaticResource PillButton}" Margin="0" Click="AddStartApp_Click"/>
                    <Button Content="Remove" Style="{StaticResource PillButton}" Click="RemoveStartApp_Click"/>
                </StackPanel>
                <CheckBox x:Name="CloseStartedCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0"
                          Content="Close them when the game ends"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="28,4,0,0"
                           Text="Only apps GameDeck opened are closed. An app that was already running is left alone."/>

                <!-- apps to close -->
                <TextBlock Text="CLOSE THESE APPS BEFORE THE GAME" Style="{StaticResource FieldHeader}" Margin="2,28,0,8"/>
                <ListBox x:Name="CloseList" Style="{StaticResource AppListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextPrimary}" FontSize="13" ToolTip="{Binding Path}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Choose running apps…" Style="{StaticResource PillButton}" Margin="0" Click="AddRunningApp_Click"/>
                    <Button Content="Add .exe…" Style="{StaticResource PillButton}" Click="AddCloseApp_Click"/>
                    <Button Content="Remove" Style="{StaticResource PillButton}" Click="RemoveCloseApp_Click"/>
                </StackPanel>
                <CheckBox x:Name="AskCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,14,0,0"
                          Content="Ask me before closing anything"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="28,4,0,0"
                           Text="Shows what will be closed and lets you start the game without closing it, or cancel."/>
                <CheckBox x:Name="ReopenCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,12,0,0"
                          Content="Reopen them when the game ends"/>
                <TextBlock Foreground="#FFC857" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Apps are asked to close the normal way, so they can offer to save your work. GameDeck never forces an app to quit: one that stays in the tray or doesn't respond within a few seconds is left running. Windows itself and game launchers can't be chosen."/>

                <!-- power -->
                <TextBlock Text="POWER" Style="{StaticResource FieldHeader}" Margin="2,28,0,8"/>
                <CheckBox x:Name="PowerCheckBox" Style="{StaticResource DarkCheckBox}"
                          Content="Use the High performance power plan while playing"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="28,4,0,10"
                           Text="Your current power plan is put back when the game ends (and at the next GameDeck start if something interrupts that)."/>

                <!-- screen mode -->
                <TextBlock Text="SCREEN WHILE PLAYING" Style="{StaticResource FieldHeader}" Margin="2,28,0,8"/>
                <ListBox x:Name="DisplayList" Style="{StaticResource AppListBox}" Height="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="DisplayHint" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,10"
                           Text="The resolution and refresh rate of your main display while the game runs. Your normal settings come back when the game ends (and at the next GameDeck start if something interrupts that). Windows' own display settings are never changed."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource Accent}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
