<Window x:Class="GameDeck.Views.BigPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameDeck.Views"
        Title="GameDeck Big Picture" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{DynamicResource AppBg}"
        Activated="Window_Activated" Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- a small round-cornered button for the mouse: search, filters, power -->
        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a tile in the row: grows and gets a purple ring while selected -->
        <Style x:Key="BigItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The tile is a fixed slot (248 x 440) in the row, and nothing in it changes size: the selected card is simply
                             the bigger one (less margin around it), drawn with real layout rather than a scale transform (a scaled ring
                             has a fractional width, and its two sides then land on different fractions of a screen pixel). With layout
                             rounding both sides snap to whole pixels. -->
                        <Canvas Width="248" Height="440" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid Canvas.Left="-4" Canvas.Top="30" Width="256" Height="380">
                                <views:RoundedClipBorder x:Name="Card" CornerRadius="9" Margin="17,24" Background="Transparent">
                                    <ContentPresenter/>
                                </views:RoundedClipBorder>
                                <!-- the ring (4 wide, inner radius 9 = the card's) is drawn over the card's outer 1 px, so no hairline of
                                     background can show between the two -->
                                <Border x:Name="Ring" CornerRadius="13" BorderBrush="#8037FE" BorderThickness="4"
                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Canvas>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Card" Property="Margin" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ======================= the screen ======================= -->
        <Grid Margin="56,36,56,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top: tabs (and the filters in use) on the left, buttons, clock and controller on the right -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Top">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal"/>
                    <TextBlock x:Name="FilterSummary" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,14,0,0"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="1100"/>

                    <!-- shown while a game started from GameDeck is running: Home (or a click) opens Resume / Close -->
                    <Border x:Name="NowPlayingBanner" Visibility="Collapsed" Background="{DynamicResource RaisedBg}" CornerRadius="8"
                            Padding="16,9" Margin="0,14,0,0" HorizontalAlignment="Left" Cursor="Hand"
                            MouseLeftButtonUp="NowPlayingBanner_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOW PLAYING" Foreground="#8037FE" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NowPlayingText" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                            <TextBlock x:Name="NowPlayingHint" Foreground="{DynamicResource TextMuted}" FontSize="14"
                                       Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- the status buttons: the network, Bluetooth and the sound output (BigPictureWindow.Status.cs) -->
                        <Border x:Name="WifiButton" Style="{StaticResource IconButton}" ToolTip="Wi-Fi networks"
                                MouseLeftButtonUp="WifiButton_Click">
                            <TextBlock x:Name="WifiGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE701;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border x:Name="BluetoothButton" Style="{StaticResource IconButton}" ToolTip="Bluetooth"
                                MouseLeftButtonUp="BluetoothButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE702;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border x:Name="SoundButton" Style="{StaticResource IconButton}" ToolTip="Sound output"
                                MouseLeftButtonUp="SoundButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border Width="1" Height="26" Background="{DynamicResource TextMuted}" Opacity="0.4" Margin="16,0,6,0"
                                VerticalAlignment="Center"/>

                        <Border x:Name="SearchButton" Style="{StaticResource IconButton}" ToolTip="Search"
                                MouseLeftButtonUp="SearchButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border x:Name="FilterButton" Style="{StaticResource IconButton}" ToolTip="Filters"
                                MouseLeftButtonUp="FilterButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71C;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings"
                                MouseLeftButtonUp="SettingsButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                        <Border x:Name="PowerButton" Style="{StaticResource IconButton}" ToolTip="Power"
                                MouseLeftButtonUp="PowerButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ClockText" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <TextBlock x:Name="InputGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{DynamicResource TextMuted}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" FontSize="14" VerticalAlignment="Center"/>
                        <!-- the controller's battery (hidden when it doesn't say) -->
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                            <TextBlock x:Name="BatteryGlyph" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMuted}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="BatteryText" Foreground="{DynamicResource TextMuted}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- middle: the row of games, then the selected game's name and details -->
            <Grid x:Name="MiddleArea" Grid.Row="1">
                <!-- "Continue playing": the games played last (only on the plain All games list, when the screen is tall enough) -->
                <StackPanel x:Name="ContinuePanel" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="CONTINUE PLAYING" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <ListBox x:Name="ContinueList" Background="Transparent" BorderThickness="0" Focusable="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Margin" Value="0,0,16,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid UseLayoutRounding="True">
                                                <views:RoundedClipBorder x:Name="Card" CornerRadius="9" Margin="3" Background="{DynamicResource PanelBg}"
                                                                         Cursor="Hand" MouseLeftButtonUp="ContinueItem_MouseLeftButtonUp">
                                                    <ContentPresenter/>
                                                </views:RoundedClipBorder>
                                                <Border x:Name="Ring" CornerRadius="12" BorderBrush="#8037FE" BorderThickness="3"
                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="250" Height="76" Loaded="ContinueItem_Loaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="51"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding PlaceholderBrush}">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <ListBox x:Name="Carousel" Height="440" Background="Transparent" BorderThickness="0" Focusable="False"
                             ItemContainerStyle="{StaticResource BigItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="Carousel_SelectionChanged" PreviewMouseMove="Carousel_PreviewMouseMove"
                             PreviewMouseLeftButtonDown="Carousel_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="Carousel_PreviewMouseLeftButtonUp"
                             PreviewMouseRightButtonUp="Carousel_RightClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" Margin="6,0"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="TileRoot" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                                    <!-- shown until (or unless) a cover exists -->
                                    <Border Background="{Binding PlaceholderBrush}">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="16"/>
                                    </Border>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- status badge -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                            Background="#CC8037FE" CornerRadius="4" Padding="7,2"
                                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- star badge for favorites -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                            Background="#99000000" CornerRadius="12" Padding="7,1"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="★" Foreground="#FFC857" FontSize="17"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- hidden games (only listed while "Hidden games" is on) are dimmed, like on the desktop -->
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter TargetName="TileRoot" Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="DetailsPanel" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="NameText" Foreground="{DynamicResource TextPrimary}" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1100"/>
                        <TextBlock x:Name="SubText" Foreground="{DynamicResource TextMuted}" FontSize="17" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextMuted}" FontSize="22" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                           Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- the Stats tab: scrolled with up / down -->
                <ScrollViewer x:Name="StatsScroll" Visibility="Collapsed" Margin="0,28,0,0"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Margin="0,0,0,24">

                        <UniformGrid Columns="3">
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatTotal" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="total playtime" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatPlayed" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="games played" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatLibrary" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="games in library" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock x:Name="StatWeek" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="played this week" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock x:Name="StatStreak" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="current streak" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20">
                                <StackPanel>
                                    <TextBlock x:Name="StatLongest" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="longest streak" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="THIS WEEK" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,30,0,10"/>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="26,20">
                            <StackPanel>
                                <TextBlock x:Name="WeekHeadline" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WeekCompare" Foreground="{DynamicResource TextSecondary}" FontSize="17" Margin="0,4,0,0"/>
                                <ItemsControl x:Name="WeekLines" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextMuted}" FontSize="17" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LAST 7 DAYS" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="14,16,14,14">
                                    <ItemsControl x:Name="DaysChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LAST 8 WEEKS" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="14,16,14,14">
                                    <ItemsControl x:Name="WeeksChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="MOST PLAYED" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,30,0,12"/>
                        <TextBlock x:Name="NoPlaytimeText" Foreground="{DynamicResource TextMuted}" FontSize="17"
                                   Text="Nothing played yet. Games you start from GameDeck are timed and show up here."/>
                        <StackPanel x:Name="TopList"/>

                        <TextBlock Text="RECENT SESSIONS" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold" Margin="2,24,0,12"/>
                        <TextBlock x:Name="NoSessionsText" Foreground="{DynamicResource TextMuted}" FontSize="17"
                                   Text="No sessions recorded yet. Each time you play a game from GameDeck, the session is listed here."/>
                        <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource SessionRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- the Stats tab: reload the numbers (X on the controller) -->
                <Border x:Name="RefreshStatsButton" Style="{StaticResource IconButton}" ToolTip="Refresh stats"
                        Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,10,0"
                        MouseLeftButtonUp="RefreshStatsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Foreground="{DynamicResource TextPrimary}" FontSize="18"/>
                </Border>

                <!-- the Media tab: every game's screenshots in a grid, moved through with the stick (BigPictureWindow.Media.cs) -->
                <ScrollViewer x:Name="MediaScroll" Visibility="Collapsed" Margin="0,28,0,0"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock x:Name="MediaHeader" Foreground="{DynamicResource TextMuted}" FontSize="17" TextWrapping="Wrap"
                                   Margin="6,0,0,16" Cursor="Hand" MouseLeftButtonUp="MediaHeader_Click"/>
                        <WrapPanel x:Name="MediaWrap" SizeChanged="MediaWrap_SizeChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- bottom: what each button does -->
            <Grid Grid.Row="2" MinHeight="40">
                <StackPanel x:Name="HintsLeft" Orientation="Horizontal" HorizontalAlignment="Left"/>
                <StackPanel x:Name="HintsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- ======================= search: on-screen keyboard ======================= -->
        <Grid x:Name="SearchOverlay" Visibility="Collapsed" Background="{DynamicResource Scrim}">
            <Border VerticalAlignment="Bottom" Background="{DynamicResource PanelBg}" CornerRadius="16,16,0,0" Padding="48,26,48,26">
                <StackPanel MaxWidth="1100">
                    <Border Background="{DynamicResource RaisedBg}" CornerRadius="8" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- the text with its cursor (built in UpdateQueryUi); a long note wraps instead of being cut off -->
                            <TextBlock x:Name="QueryText" Foreground="{DynamicResource TextPrimary}" FontSize="28" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,20,0"/>
                            <TextBlock x:Name="QueryHint" Text="Type to search your games" Foreground="{DynamicResource TextHint}" FontSize="28"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0"/>

                            <!-- the buttons that move the cursor, and the number of games / letters -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="CaretHints" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource TextMuted}" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- (no hint row: each key shows the controller button that does the same) -->
                    <StackPanel x:Name="KeyRows" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= filters: a panel on the right ======================= -->
        <Grid x:Name="FilterOverlay" Visibility="Collapsed" Background="{DynamicResource Scrim}">
            <Border HorizontalAlignment="Right" Width="580" Background="{DynamicResource PanelBg}" Padding="0,28,0,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Filters" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold"
                               Margin="40,0,0,14"/>
                    <StackPanel x:Name="FilterHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <ScrollViewer x:Name="FilterScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FilterList" Margin="28,0,28,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= game menu: the right-click menu of the desktop library, for the Menu button ======================= -->
        <Grid x:Name="GameMenuOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrong}">
            <Border Width="560" MaxHeight="900" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="0,24,0,16">
                <DockPanel>
                    <TextBlock x:Name="GameMenuTitle" DockPanel.Dock="Top" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="40,0,40,14"/>
                    <StackPanel x:Name="GameMenuHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GameMenuList" Margin="20,0,20,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= settings: full screen, sections on the left, their settings on the right ======================= -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="{DynamicResource AppBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- the sections (BigPictureWindow.Settings.cs fills them) -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" Padding="0,44,0,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Settings" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="SemiBold"
                               Margin="44,0,0,26"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsNav"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- the chosen section: a title, then its settings as cards under small headings -->
            <DockPanel Grid.Column="1" Margin="56,44,56,30">
                <StackPanel x:Name="SettingsHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,18,0,0"/>
                <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}"
                           FontSize="17" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="SettingsPageTitle" DockPanel.Dock="Top" Foreground="{DynamicResource TextPrimary}" FontSize="34"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsList" Margin="0,0,0,12"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ======================= add games: a file browser for the controller (Settings > Add games) ======================= -->
        <Grid x:Name="BrowseOverlay" Visibility="Collapsed" Background="{DynamicResource Scrim}">
            <Border HorizontalAlignment="Right" Width="780" Background="{DynamicResource PanelBg}" Padding="0,28,0,20">
                <DockPanel>
                    <TextBlock x:Name="BrowseTitle" DockPanel.Dock="Top" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="40,0,40,14"/>
                    <StackPanel x:Name="BrowseHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="BrowseStatus" DockPanel.Dock="Bottom" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}"
                               FontSize="16" TextWrapping="Wrap" Margin="40,12,40,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BrowseList" Margin="28,0,28,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= a screenshot, full screen (from the game's page) ======================= -->
        <Grid x:Name="ShotOverlay" Visibility="Collapsed" Background="#F0000000">
            <Image x:Name="ShotImage" Margin="48,40,48,110" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="ShotCaption" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,66"
                       Foreground="#C8D0DC" FontSize="18"/>
            <StackPanel x:Name="ShotHints" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22"/>
        </Grid>

        <!-- ======================= a game's page: Play has to be chosen here ======================= -->
        <Grid x:Name="DetailsOverlay" Visibility="Collapsed" Background="{DynamicResource AppBg}">
            <DockPanel Margin="56,36,56,32">
                <StackPanel x:Name="DetailsHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <!-- the very same page the desktop library opens for a game -->
                <views:GameDetailsView x:Name="DetailsView" HorizontalAlignment="Center"
                                       BackRequested="DetailsView_BackRequested" PlayRequested="DetailsView_PlayRequested"
                                       ScreenshotRequested="DetailsView_ScreenshotRequested"/>
            </DockPanel>
        </Grid>

        <!-- ======================= power menu ======================= -->
        <Grid x:Name="PowerOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrong}">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource PanelBg}" CornerRadius="10">
                <StackPanel>
                    <TextBlock x:Name="PowerTitle" Text="Power" Foreground="{DynamicResource TextPrimary}" FontSize="24" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="20,24,20,18"/>
                    <StackPanel x:Name="PowerList"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= the controller's shortcuts (Power menu > Show Controller Shortcuts) ======================= -->
        <Grid x:Name="ShortcutsOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimStrong}">
            <Border MaxWidth="1180" Margin="60,50" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource PanelBg}"
                    CornerRadius="10" Padding="56,40,56,26">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Controller Shortcuts" Foreground="{DynamicResource TextPrimary}" FontSize="32"
                               FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <StackPanel x:Name="ShortcutsHints" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <!-- two columns of rows (built in BigPictureWindow.Shortcuts.cs); scrolls when the screen is short -->
                    <ScrollViewer x:Name="ShortcutsScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ShortcutsLeft"/>
                            <StackPanel x:Name="ShortcutsRight" Grid.Column="2"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= the screen saver: covers moving on black, over everything ======================= -->
        <views:ScreenSaverView x:Name="ScreenSaver"/>
    </Grid>
</Window>
