<Window x:Class="GameDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GameDeck.Controls"
        xmlns:views="clr-namespace:GameDeck.Views"
        Title="GameDeck" Height="720" Width="1200" MinWidth="1000" MinHeight="520"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged">

    <!-- GameDeck draws its own title bar (TitleBar below), so a game's picture can show behind it like in GOG Galaxy. Windows
         still does the rest: dragging the top strip, double-click to maximize, snapping, the resize borders (MainWindow.TitleBar.cs) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- the title bar's buttons, drawn like Windows 11's own -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B3C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ctl:ScaleConverter x:Key="Scale"/>

        <!-- fake cover art for the "pick a game for me" tile -->
        <LinearGradientBrush x:Key="FakeCover1" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6D3BD9" Offset="0"/><GradientStop Color="#2A1B5E" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="FakeCover2" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8744F" Offset="0"/><GradientStop Color="#7A2A3C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="FakeCover3" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2BA6B5" Offset="0"/><GradientStop Color="#143B5C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="FakeCover4" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D94F9A" Offset="0"/><GradientStop Color="#4A1B5E" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="FakeCover5" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8C14F" Offset="0"/><GradientStop Color="#7A5A2A" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="FakeCover6" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4F7BE8" Offset="0"/><GradientStop Color="#1B2A5E" Offset="1"/></LinearGradientBrush>

        <!-- section headings in the filter panel -->
        <Style x:Key="FilterHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- "All games / Favorites / Recently played / Stats" tabs: grey text, white + blue underline when selected -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Removes the default blue selection box so only our own tile highlight shows -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin rounded bar for the "most played" list -->
        <Style x:Key="StatBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource RaisedBg}" CornerRadius="4"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="4"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- artwork of the "pick a game for me" tile: a tilted wall of fake covers with the text on top -->
        <DataTemplate x:Key="RandomTileArt">
                                <Grid IsHitTestVisible="False">
                                    <Border Background="#141A2B"/>
                                    <Canvas Width="280" Height="410" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform Angle="-16"/>
                                        </Canvas.RenderTransform>
                                        <Border Canvas.Left="0" Canvas.Top="0" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover1}"/>
                                        <Border Canvas.Left="0" Canvas.Top="101" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover4}"/>
                                        <Border Canvas.Left="0" Canvas.Top="202" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover1}"/>
                                        <Border Canvas.Left="0" Canvas.Top="303" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover4}"/>
                                        <Border Canvas.Left="70" Canvas.Top="-50" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover3}"/>
                                        <Border Canvas.Left="70" Canvas.Top="51" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover6}"/>
                                        <Border Canvas.Left="70" Canvas.Top="152" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover3}"/>
                                        <Border Canvas.Left="70" Canvas.Top="253" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover6}"/>
                                        <Border Canvas.Left="140" Canvas.Top="0" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover5}"/>
                                        <Border Canvas.Left="140" Canvas.Top="101" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover2}"/>
                                        <Border Canvas.Left="140" Canvas.Top="202" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover5}"/>
                                        <Border Canvas.Left="140" Canvas.Top="303" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover2}"/>
                                        <Border Canvas.Left="210" Canvas.Top="-50" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover1}"/>
                                        <Border Canvas.Left="210" Canvas.Top="51" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover4}"/>
                                        <Border Canvas.Left="210" Canvas.Top="152" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover1}"/>
                                        <Border Canvas.Left="210" Canvas.Top="253" Width="62" Height="93" CornerRadius="3" Background="{StaticResource FakeCover4}"/>
                                    </Canvas>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#33141A2B" Offset="0"/>
                                                <GradientStop Color="#D90B0814" Offset="0.7"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource Accent}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pick a game&#x0A;for me" Foreground="White" FontSize="19" FontWeight="Bold"
                                                   TextAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock Text="Feeling lucky?" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                                   TextAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- (WindowRoot's margin keeps everything on screen while maximized: see Window_StateChanged) -->
    <Grid x:Name="WindowRoot">
    <!-- the window's content, 24 around it as before (the top one below the 32 of the title bar) -->
    <Grid x:Name="RootGrid" Margin="24,56,24,24" Background="Transparent"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

        <!-- ======================= the library ======================= -->
        <Grid x:Name="LibraryView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 1: title, game count and the buttons -->
            <DockPanel Grid.Row="0" Margin="8,0,8,10" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Library" Foreground="{DynamicResource TextPrimary}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{DynamicResource TextMuted}"
                           FontSize="14" Margin="16,6,0,0" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BigPictureButton" Style="{StaticResource IconButton}"
                            FocusVisualStyle="{x:Null}" Content="&#xE7FC;"
                            Click="BigPictureButton_Click" ToolTip="Big Picture mode: full screen, for a controller (F11)"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Click="SettingsButton_Click" ToolTip="Settings"/>
                </StackPanel>
            </DockPanel>

            <!-- Row 2: tabs on the left; sort, filters, tile size and search on the right -->
            <DockPanel Grid.Row="1" Margin="8,0,8,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                    <RadioButton x:Name="AllTab" Content="All games" Tag="All" GroupName="View"
                                 IsChecked="True" Style="{StaticResource TabButton}" Checked="ViewTab_Checked"/>
                    <RadioButton Content="Favorites" Tag="Favorites" GroupName="View"
                                 Style="{StaticResource TabButton}" Checked="ViewTab_Checked"/>
                    <RadioButton Content="Recently played" Tag="Recent" GroupName="View"
                                 Style="{StaticResource TabButton}" Checked="ViewTab_Checked"/>
                    <RadioButton Content="Stats" Tag="Stats" GroupName="View"
                                 Style="{StaticResource TabButton}" Checked="ViewTab_Checked"/>
                    <RadioButton Content="Media" Tag="Media" GroupName="View"
                                 Style="{StaticResource TabButton}" Checked="ViewTab_Checked"/>
                </StackPanel>

                <!-- the Stats tab's refresh: an icon like Settings and Big Picture, where the filter icon is on the other tabs -->
                <Button x:Name="RefreshStatsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                        Content="&#xE72C;" Click="RefreshStatsButton_Click" Visibility="Collapsed"
                        ToolTip="Reload the stats (for example after a game session ended)"/>

                <StackPanel x:Name="FilterBar" DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- tile size: a slider that snaps to the scales in SettingsService.TileScales -->
                    <Slider x:Name="TileSlider" Style="{StaticResource SlimSlider}" Width="90" Margin="0,8,16,0" VerticalAlignment="Top"
                            Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="1" ValueChanged="TileSlider_ValueChanged"/>

                    <!-- search box; the filters that are on show up as chips above the text, each with its own x -->
                    <Border Width="290" Background="{DynamicResource RaisedBg}" CornerRadius="6" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <WrapPanel x:Name="FilterChips" Margin="8,8,30,0" Visibility="Collapsed"/>

                                <!-- clears every filter at once (only shown while a filter is on) -->
                                <TextBlock x:Name="ClearAllFiltersButton" Text="✕" Foreground="{DynamicResource TextSecondary}" FontSize="14" Cursor="Hand"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0" Visibility="Collapsed"
                                           MouseLeftButtonDown="ClearAllFilters_MouseDown" ToolTip="Clear all filters"/>
                            </Grid>

                            <Grid>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontSize="14"
                                         Height="{StaticResource ToolbarHeight}" Padding="10,0,30,0" VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

                                <!-- hint text, only shown while the box is empty -->
                                <TextBlock Text="Search (Ctrl+F)" Foreground="{DynamicResource TextHint}" FontSize="14" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- clear button, only shown while there is text -->
                                <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" FontSize="13" Cursor="Hand"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           MouseLeftButtonDown="ClearSearch_MouseDown" ToolTip="Clear search">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- filter icon (like Steam): sort, launcher, category and hidden games live in its menu -->
                    <Button x:Name="FilterButton" Margin="8,0,0,0" VerticalAlignment="Top" Content="&#xE71C;"
                            Click="FilterButton_Click" ToolTip="Sort and filter">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <!-- while the panel is open, a click on the icon lands outside the panel: it closes it, and does not reopen it -->
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=FilterPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- the filter panel (like Steam's "Library Filters"); its lists are filled in when it opens -->
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="540" Margin="0,6,14,14" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource RaisedBg}" BorderThickness="1"
                                CornerRadius="10" Padding="24,20,24,22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Library Filters" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold"/>

                                <ScrollViewer MaxHeight="430" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="LAUNCHER" Style="{StaticResource FilterHeader}"/>
                                            <StackPanel x:Name="LauncherList"/>

                                            <TextBlock Text="STATUS" Style="{StaticResource FilterHeader}" Margin="0,22,0,10"/>
                                            <StackPanel x:Name="StatusList"/>

                                            <TextBlock Text="SMART FILTERS" Style="{StaticResource FilterHeader}" Margin="0,22,0,10"/>
                                            <StackPanel x:Name="SmartList"/>

                                            <TextBlock Text="SHOW" Style="{StaticResource FilterHeader}" Margin="0,22,0,10"/>
                                            <CheckBox x:Name="HiddenCheckBox" Style="{StaticResource DarkCheckBox}"
                                                      Content="Hidden games" Checked="HiddenCheckBox_Changed" Unchecked="HiddenCheckBox_Changed"/>
                                            <!-- Steam DLC and soundtracks installed as apps of their own (only offered when there are some) -->
                                            <CheckBox x:Name="AddOnsCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"
                                                      Content="DLC and soundtracks" Checked="AddOnsCheckBox_Changed" Unchecked="AddOnsCheckBox_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="SORT BY" Style="{StaticResource FilterHeader}"/>
                                            <StackPanel x:Name="SortList"/>

                                            <TextBlock Text="CATEGORY" Style="{StaticResource FilterHeader}" Margin="0,22,0,10"/>
                                            <StackPanel x:Name="CategoryList"/>

                                            <TextBlock Text="GENRE" Style="{StaticResource FilterHeader}" Margin="0,22,0,10"/>
                                            <StackPanel x:Name="GenreList"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>

            <!-- Continue playing: the games played last (only on the plain All games list) -->
            <StackPanel x:Name="ContinueBar" Grid.Row="2" Margin="8,0,8,16" Visibility="Collapsed">
                <TextBlock Text="CONTINUE PLAYING" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>
                <ItemsControl x:Name="ContinueList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:RoundedClipBorder Width="240" Height="64" CornerRadius="8" Margin="0,0,12,12" Cursor="Hand"
                                                     Loaded="ContinueCard_Loaded" MouseLeftButtonUp="ContinueCard_MouseLeftButtonUp">
                                <views:RoundedClipBorder.Style>
                                    <Style TargetType="views:RoundedClipBorder">
                                        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:RoundedClipBorder.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="43"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding PlaceholderBrush}">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ContinueNote}" ToolTip="{Binding ContinueNote}" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </views:RoundedClipBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The game grid. VirtualizingTilePanel only creates the tiles that are on screen. -->
            <ListBox x:Name="GameList" Grid.Row="3"
                     ItemsSource="{Binding Games}"
                     ItemContainerStyle="{StaticResource TileItem}"
                     SelectionMode="Extended" SelectionChanged="GameList_SelectionChanged"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingPanel.IsVirtualizing="True"
                     PreviewMouseLeftButtonDown="GameList_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="GameList_PreviewMouseLeftButtonUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:VirtualizingTilePanel ItemInset="16" TileAspect="1.5"
                            ItemWidth="{Binding TileScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter='160;16'}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The tile is always laid out at 160x240 (a 2:3 poster, like Steam's covers); the Viewbox stretches it to fill its slot (the panel decides the slot size) -->
                        <Viewbox Margin="8" Stretch="Fill">
                            <Grid x:Name="Root" Width="160" Height="240"
                                  Background="Transparent" RenderTransformOrigin="0.5,0.5"
                                  Loaded="Tile_Loaded" Unloaded="Tile_Unloaded" ContextMenuOpening="Tile_ContextMenuOpening">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,160,240" RadiusX="4" RadiusY="4"/>
                                </Grid.Clip>
                                <!-- its entries are built each time it opens (Tile_ContextMenuOpening › FillGameMenu) -->
                                <Grid.ContextMenu>
                                    <ContextMenu/>
                                </Grid.ContextMenu>

                                <!-- shown until (or unless) a cover exists -->
                                <Border Background="{Binding PlaceholderBrush}">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="12"/>
                                </Border>

                                <!-- centred: a cover of another shape (Epic's are wider) is cut evenly on both sides. With the
                                     default Stretch alignment WPF keeps the top-left corner and cuts only the right/bottom. -->
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- the "pick a game for me" tile's artwork: built only for that tile (RandomTileArt), not for every game -->
                                <ContentControl IsHitTestVisible="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRandomTile}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource RandomTileArt}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!-- playtime along the bottom edge (only once the game has been played) -->
                                <Border VerticalAlignment="Bottom" Padding="10,22,10,8" IsHitTestVisible="False"
                                        Visibility="{Binding HasPlaytime, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#D9000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding PlaytimeShort, StringFormat={}{0} played}"
                                               Foreground="#E6EDF5" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <!-- status badge (Playing / Completed / Up next / Dropped) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                                        Background="{DynamicResource AccentBadge}" CornerRadius="4" Padding="6,2" IsHitTestVisible="False"
                                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>

                                <!-- star badge for favorites -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                        Background="#99000000" CornerRadius="10" Padding="6,1" IsHitTestVisible="False"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="★" Foreground="#FFC857" FontSize="14"/>
                                </Border>

                                <!-- the rating, bottom right ("4 ★": a number, so it isn't taken for the favorite star) -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,7"
                                        Background="#99000000" CornerRadius="8" Padding="6,1,6,2" IsHitTestVisible="False"
                                        Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0} ★}" Foreground="#FFC857" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border x:Name="Highlight" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                        CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                            </Grid>
                        </Viewbox>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <!-- hidden games (only visible while "Show hidden games" is on) are dimmed -->
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- the Media tab: every game's screenshots, newest first, 60 at a time (MainWindow.Media.cs) -->
            <ScrollViewer x:Name="MediaPanel" Grid.Row="3" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,0,8,24">
                    <DockPanel Margin="2,0,0,14">
                        <!-- the game filter: a menu of the games that have pictures (MainWindow.Media.cs) -->
                        <Button x:Name="MediaGameButton" DockPanel.Dock="Left" Style="{StaticResource PillButton}" Padding="14,6" FontSize="13"
                                Margin="0,0,14,0" Visibility="Collapsed" Click="MediaGameButton_Click"/>
                        <TextBlock x:Name="MediaHeader" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="MediaWrap" SizeChanged="MediaWrap_SizeChanged"/>
                    <Button x:Name="MediaMoreButton" Style="{StaticResource PillButton}" Padding="16,8" FontSize="14"
                            HorizontalAlignment="Left" Margin="2,6,0,0" Visibility="Collapsed" Click="MediaMoreButton_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- the Stats tab -->
            <ScrollViewer x:Name="StatsPanel" Grid.Row="3" Visibility="Collapsed" ScrollChanged="StatsPanel_ScrollChanged"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- like a game's page: when the window is wide, play over time on the left and the lists on the right
                     (UpdateStatsLayout); otherwise one column, the right one under the left one -->
                <Grid x:Name="StatsRoot" Margin="8,4,8,0" MaxWidth="760" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="StatsGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="StatsSideColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <!-- six boxes of one size: every cell of the grid is as wide as the widest box. The 14 px gaps are the
                         boxes' own right and bottom margins; the grid's negative margins take the outer ones back. -->
                    <UniformGrid Columns="3" Margin="0,0,-14,-14">
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170">
                            <StackPanel>
                                <TextBlock x:Name="StatTotal" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="total playtime" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="StatPlayed" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="games played" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="StatLibrary" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="games in library" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- over time (from the dated play sessions) -->
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="StatWeek" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="played this week" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="StatStreak" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="current streak" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock x:Name="StatLongestStreak" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="longest streak" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="THIS WEEK" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,24,0,10"/>
                    <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="22,16">
                        <StackPanel>
                            <TextBlock x:Name="WeekHeadline" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WeekCompare" Foreground="{DynamicResource TextSecondary}" FontSize="15" Margin="0,4,0,0"/>
                            <ItemsControl x:Name="WeekLines" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="THIS YEAR" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,24,0,10"/>
                    <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="22,16">
                        <StackPanel>
                            <TextBlock x:Name="YearHeadline" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="YearCompare" Foreground="{DynamicResource TextSecondary}" FontSize="15" Margin="0,4,0,0"/>
                            <ItemsControl x:Name="YearLines" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextMuted}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LAST 7 DAYS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="12,14,12,12">
                                <ItemsControl x:Name="DaysChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LAST 8 WEEKS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>
                            <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="12,14,12,12">
                                <ItemsControl x:Name="WeeksChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="UndatedNote" Foreground="{DynamicResource TextHint}" FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0"
                               Text="The charts, streaks and sessions cover play from when GameDeck started recording sessions. Earlier playtime is still counted in the totals."/>
                </StackPanel>

                <!-- the right column (or, when narrow, everything under the charts) -->
                <StackPanel x:Name="StatsSidePanel" Grid.Row="1">
                    <!-- (its top margin: UpdateStatsLayout) -->
                    <TextBlock x:Name="StatsSideHeader" Text="MOST PLAYED" Foreground="{DynamicResource TextMuted}" FontSize="12"
                               FontWeight="SemiBold" Margin="2,28,0,10"/>
                    <TextBlock x:Name="NoStatsText" Foreground="{DynamicResource TextMuted}" FontSize="15" TextWrapping="Wrap"
                               Text="Nothing played yet. Games you launch from GameDeck are timed and show up here."/>

                    <ItemsControl x:Name="TopGamesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource StatBar}"
                                                 Value="{Binding Fraction, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="RECENT SESSIONS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                               Margin="2,18,0,10"/>
                    <TextBlock x:Name="NoSessionsText" Foreground="{DynamicResource TextMuted}" FontSize="15" TextWrapping="Wrap"
                               Text="No sessions recorded yet. Each time you play a game from GameDeck, the session is listed here."/>
                    <ItemsControl x:Name="RecentSessionsList" ItemTemplate="{StaticResource SessionRowTemplate}"/>

                    <!-- how many games each launcher on this PC has (LauncherStats): only launchers that are installed -->
                    <StackPanel x:Name="LaunchersPanel" Visibility="Collapsed">
                        <TextBlock Text="LAUNCHERS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,24,0,10"/>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="22,16">
                            <ItemsControl x:Name="LauncherLines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="15"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="15" Margin="14,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- the space the games take (DiskUsage): once some sizes are known. Last: the rest is about playtime -->
                    <StackPanel x:Name="DiskPanel" Visibility="Collapsed">
                        <TextBlock Text="SPACE ON DISK" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="2,24,0,10"/>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="22,16">
                            <StackPanel>
                                <TextBlock x:Name="DiskHeadline" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiskCompare" Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <!-- the biggest games (DiskUsage.Line), each with an Uninstall button on the right -->
                                <ItemsControl x:Name="DiskLines" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="Uninstall" Style="{StaticResource PillButton}" Padding="12,4"
                                                        Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Click="DiskUninstall_Click"
                                                        ToolTip="Uninstall this game (its launcher or uninstaller takes over)"/>
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextMuted}" FontSize="15"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- every game with a known size instead of the biggest few, and back (ShowDiskLines) -->
                                <Button x:Name="DiskShowAllButton" Style="{StaticResource PillButton}" Margin="0,6,0,0" Padding="14,6"
                                        HorizontalAlignment="Left" Click="DiskShowAllButton_Click"/>
                                <TextBlock Foreground="{DynamicResource TextHint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="A game you uninstall leaves the library by itself."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Height="24"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- message for empty views (no favorites yet, no search results...) -->
            <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="{DynamicResource TextMuted}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- ======================= a game's page (click a tile) ======================= -->
        <!-- (over RootGrid's margin and the title bar too, so the game's picture fills the whole window, behind the title bar
             like in GOG Galaxy. The page starts below the title bar; with the page's own 24 around it, its text sits where the
             library's does, and the scroll bar is at the window's edge) -->
        <views:GameDetailsView x:Name="DetailsPanel" Visibility="Collapsed" Margin="-24,-56,-24,-24" PageMargin="8,32,0,0"
                               BackRequested="DetailsPanel_BackRequested"
                               PlayRequested="DetailsPanel_PlayRequested"
                               ScreenshotRequested="DetailsPanel_ScreenshotRequested"
                               RatingRequested="DetailsPanel_RatingRequested"/>

        <!-- (the settings, opened with the gear, have a window of their own: SettingsWindow) -->
    </Grid>

    <!-- ======================= the title bar: see-through, over whatever the window shows ======================= -->
    <Grid x:Name="TitleBar" Height="32" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
            <Image x:Name="TitleIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,0,1"
                       FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
