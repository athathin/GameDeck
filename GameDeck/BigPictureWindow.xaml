<Window x:Class="GameDeck.Views.BigPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameDeck.Views"
        Title="GameDeck Big Picture" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#171A21"
        Activated="Window_Activated" Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- a small round-cornered button for the mouse: search, filters, power -->
        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Background" Value="#2A2F3A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A4050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a tile in the row: grows and gets a purple ring while selected -->
        <Style x:Key="BigItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Margin="14,48" Width="220" Height="330" Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- ClipToBounds only clips to a rectangle, so the cover needs a real rounded clip to match the ring -->
                            <Border CornerRadius="8">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,220,330" RadiusX="8" RadiusY="8"/>
                                </Border.Clip>
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Ring" CornerRadius="8" BorderBrush="#8037FE" BorderThickness="4"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ======================= the screen ======================= -->
        <Grid Margin="56,36,56,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top: tabs (and the filters in use) on the left, buttons, clock and controller on the right -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Top">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal"/>
                    <TextBlock x:Name="FilterSummary" Foreground="#8A91A0" FontSize="15" Margin="0,14,0,0"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="1100"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border x:Name="SearchButton" Style="{StaticResource IconButton}" ToolTip="Search"
                                MouseLeftButtonUp="SearchButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="White" FontSize="18"/>
                        </Border>
                        <Border x:Name="FilterButton" Style="{StaticResource IconButton}" ToolTip="Filters"
                                MouseLeftButtonUp="FilterButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71C;" Foreground="White" FontSize="18"/>
                        </Border>
                        <Border x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings"
                                MouseLeftButtonUp="SettingsButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="White" FontSize="18"/>
                        </Border>
                        <Border x:Name="PowerButton" Style="{StaticResource IconButton}" ToolTip="Power"
                                MouseLeftButtonUp="PowerButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" Foreground="White" FontSize="18"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ClockText" Foreground="White" FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="#8A91A0" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Foreground="#8A91A0" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- middle: the row of games, then the selected game's name and details -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center">
                    <ListBox x:Name="Carousel" Height="440" Background="Transparent" BorderThickness="0" Focusable="False"
                             ItemContainerStyle="{StaticResource BigItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="Carousel_SelectionChanged" PreviewMouseMove="Carousel_PreviewMouseMove"
                             PreviewMouseLeftButtonDown="Carousel_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="Carousel_PreviewMouseLeftButtonUp"
                             PreviewMouseRightButtonUp="Carousel_RightClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                                    <!-- shown until (or unless) a cover exists -->
                                    <Border Background="{Binding PlaceholderBrush}">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="16"/>
                                    </Border>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- status badge -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                            Background="#CC8037FE" CornerRadius="4" Padding="7,2"
                                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- star badge for favorites -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                            Background="#99000000" CornerRadius="12" Padding="7,1"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="★" Foreground="#FFC857" FontSize="17"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="DetailsPanel" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="NameText" Foreground="White" FontSize="36" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1100"/>
                        <TextBlock x:Name="SubText" Foreground="#8A91A0" FontSize="17" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="EmptyText" Foreground="#8A91A0" FontSize="22" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                           Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- the Stats tab: scrolled with up / down -->
                <ScrollViewer x:Name="StatsScroll" Visibility="Collapsed" Margin="0,28,0,0"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Margin="0,0,0,24">

                        <UniformGrid Columns="3">
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatTotal" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="total playtime" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatPlayed" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="games played" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="StatLibrary" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="games in library" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock x:Name="StatWeek" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="played this week" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock x:Name="StatStreak" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="current streak" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E222B" CornerRadius="10" Padding="26,20">
                                <StackPanel>
                                    <TextBlock x:Name="StatLongest" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
                                    <TextBlock Text="longest streak" Foreground="#8A91A0" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LAST 7 DAYS" Foreground="#8A91A0" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <Border Background="#1E222B" CornerRadius="10" Padding="14,16,14,14">
                                    <ItemsControl x:Name="DaysChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LAST 8 WEEKS" Foreground="#8A91A0" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <Border Background="#1E222B" CornerRadius="10" Padding="14,16,14,14">
                                    <ItemsControl x:Name="WeeksChart" ItemTemplate="{StaticResource ChartBarTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="MOST PLAYED" Foreground="#8A91A0" FontSize="14" FontWeight="SemiBold" Margin="2,30,0,12"/>
                        <TextBlock x:Name="NoPlaytimeText" Foreground="#8A91A0" FontSize="17"
                                   Text="Nothing played yet. Games you start from GameDeck are timed and show up here."/>
                        <StackPanel x:Name="TopList"/>

                        <TextBlock Text="RECENT SESSIONS" Foreground="#8A91A0" FontSize="14" FontWeight="SemiBold" Margin="2,24,0,12"/>
                        <TextBlock x:Name="NoSessionsText" Foreground="#8A91A0" FontSize="17"
                                   Text="No sessions recorded yet. Each time you play a game from GameDeck, the session is listed here."/>
                        <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource SessionRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- bottom: what each button does -->
            <Grid Grid.Row="2">
                <StackPanel x:Name="HintsLeft" Orientation="Horizontal" HorizontalAlignment="Left"/>
                <StackPanel x:Name="HintsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- ======================= search: on-screen keyboard ======================= -->
        <Grid x:Name="SearchOverlay" Visibility="Collapsed" Background="#B30E1016">
            <Border VerticalAlignment="Bottom" Background="#1E222B" CornerRadius="16,16,0,0" Padding="48,26,48,26">
                <StackPanel MaxWidth="1100">
                    <Border Background="#2A2F3A" CornerRadius="8" Padding="20,12">
                        <Grid>
                            <TextBlock x:Name="QueryText" Foreground="White" FontSize="28" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,160,0"/>
                            <TextBlock x:Name="QueryHint" Text="Type to search your games" Foreground="#6F7685" FontSize="28"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="ResultCountText" Foreground="#8A91A0" FontSize="16" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="KeyRows" Margin="0,18,0,0"/>
                    <StackPanel x:Name="SearchHints" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= filters: a panel on the right ======================= -->
        <Grid x:Name="FilterOverlay" Visibility="Collapsed" Background="#B30E1016">
            <Border HorizontalAlignment="Right" Width="580" Background="#1E222B" Padding="0,28,0,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Filters" Foreground="White" FontSize="28" FontWeight="SemiBold"
                               Margin="40,0,0,14"/>
                    <StackPanel x:Name="FilterHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <ScrollViewer x:Name="FilterScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FilterList" Margin="28,0,28,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= game menu: the right-click menu of the desktop library, for the Menu button ======================= -->
        <Grid x:Name="GameMenuOverlay" Visibility="Collapsed" Background="#D90E1016">
            <Border Width="560" MaxHeight="900" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#1E222B" CornerRadius="10" Padding="0,24,0,16">
                <DockPanel>
                    <TextBlock x:Name="GameMenuTitle" DockPanel.Dock="Top" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="40,0,40,14"/>
                    <StackPanel x:Name="GameMenuHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GameMenuList" Margin="20,0,20,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= settings: a panel on the right, like the filters ======================= -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#B30E1016">
            <Border HorizontalAlignment="Right" Width="780" Background="#1E222B" Padding="0,28,0,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Settings" Foreground="White" FontSize="28" FontWeight="SemiBold"
                               Margin="40,0,0,14"/>
                    <StackPanel x:Name="SettingsHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Visibility="Collapsed" Foreground="#C5CBD6"
                               FontSize="16" TextWrapping="Wrap" Margin="40,12,40,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsList" Margin="28,0,28,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= a game's page: Play has to be chosen here ======================= -->
        <Grid x:Name="DetailsOverlay" Visibility="Collapsed" Background="#171A21">
            <DockPanel Margin="56,36,56,32">
                <StackPanel x:Name="DetailsHints" DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <!-- the very same page the desktop library opens for a game -->
                <views:GameDetailsView x:Name="DetailsView" HorizontalAlignment="Center"
                                       BackRequested="DetailsView_BackRequested" PlayRequested="DetailsView_PlayRequested"/>
            </DockPanel>
        </Grid>

        <!-- ======================= power menu ======================= -->
        <Grid x:Name="PowerOverlay" Visibility="Collapsed" Background="#D90E1016">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1E222B" CornerRadius="10">
                <StackPanel>
                    <TextBlock x:Name="PowerTitle" Text="Power" Foreground="White" FontSize="24" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="20,24,20,18"/>
                    <StackPanel x:Name="PowerList"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
