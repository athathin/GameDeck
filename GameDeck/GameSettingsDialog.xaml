<Window x:Class="GameDeck.Views.GameSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit game" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="Edit game" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,18,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}"/>

        <TextBlock Text="Categories" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
        <TextBox x:Name="TagsBox" Style="{StaticResource DarkTextBox}"/>
        <TextBlock Text="Separate them with commas, for example: Co-op, Racing" Foreground="{DynamicResource TextHint}" FontSize="12"
                   Margin="0,5,0,0"/>

        <TextBlock Text="Your rating" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
        <StackPanel x:Name="StarsPanel" Orientation="Horizontal"/>

        <TextBlock Text="Notes" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="84" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

        <TextBlock Text="Launch options" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,16,0,6"/>
        <TextBox x:Name="ArgsBox" Style="{StaticResource DarkTextBox}"/>
        <CheckBox x:Name="AdminCheckBox" Style="{StaticResource DarkCheckBox}" Content="Run as administrator"
                  Margin="0,12,0,0"/>
        <TextBlock x:Name="LaunchHint" Foreground="{DynamicResource TextHint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button Content="Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogButton}" Background="{DynamicResource Accent}" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
