<Window x:Class="GameDeck.Views.GameSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit game" Width="500" Height="660" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- the INFO / MEDIA tabs: capitals, underlined in the accent color while chosen -->
        <Style x:Key="DialogTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="0,0,0,10"/>
                            <Border x:Name="line" Height="2" CornerRadius="1" Background="{DynamicResource Accent}" Visibility="Hidden"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="line" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the label on the left of each row -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: the game's picture, 'Editing "Name"' and where it comes from -->
        <Border Background="{DynamicResource PanelBg}" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource RaisedBg}" ClipToBounds="True">
                    <Border.Clip>
                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                    </Border.Clip>
                    <Image x:Name="HeaderImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                    <TextBlock x:Name="HeaderSource" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- tabs -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource RaisedBg}" BorderThickness="0,0,0,1" Padding="24,18,24,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="InfoTab" Content="INFO" GroupName="EditTabs" IsChecked="True" Style="{StaticResource DialogTab}"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="MediaTab" Content="MEDIA" GroupName="EditTabs" Style="{StaticResource DialogTab}"
                             Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <!-- INFO -->
        <ScrollViewer x:Name="InfoPage" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,18,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Title" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"/>

                <TextBlock Grid.Row="1" Text="Genres" Style="{StaticResource RowLabel}" Margin="0,14,16,0"
                           x:Name="GenresLabel"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GenresText" Foreground="{DynamicResource TextMuted}" FontSize="13"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,14,0,0"/>

                <TextBlock Grid.Row="2" Text="Rating" Style="{StaticResource RowLabel}" Margin="0,14,16,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" x:Name="StarsPanel" Orientation="Horizontal" Margin="0,14,0,0"/>

                <TextBlock Grid.Row="3" Text="Categories" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,24,16,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,16,0,0">
                    <TextBox x:Name="TagsBox" Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Text="Separate them with commas, for example: Co-op, Racing" Foreground="{DynamicResource TextHint}"
                               FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Where I left off" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,24,16,0"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,16,0,0">
                    <TextBox x:Name="LeftOffBox" Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Text="Shown on the game's page and in Continue playing" Foreground="{DynamicResource TextHint}"
                               FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="Notes" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,24,16,0"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="NotesBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="84" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Margin="0,16,0,0"/>

                <TextBlock Grid.Row="6" Text="Visibility" Style="{StaticResource RowLabel}" Margin="0,18,16,0"/>
                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="HiddenCheckBox" Style="{StaticResource DarkCheckBox}"
                          Content="Hide from my games list" Margin="0,18,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- MEDIA -->
        <ScrollViewer x:Name="MediaPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid Margin="24,18,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cover" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="suggested size" Foreground="{DynamicResource TextHint}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="600 x 900 px" Foreground="{DynamicResource TextHint}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Width="160" Height="240" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource RaisedBg}"
                            ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="CoverPreview_Click"
                            ToolTip="Choose an image">
                        <Grid>
                            <TextBlock x:Name="CoverPlaceholder" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                            <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Choose image…" Style="{StaticResource PillButton}" Margin="0" Click="ChooseCover_Click"/>
                        <Button x:Name="ResetCoverButton" Content="Use automatic cover" Style="{StaticResource PillButton}"
                                Click="ResetCover_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CoverHint" Foreground="{DynamicResource TextHint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Cancel / OK -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource RaisedBg}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True"
                        Style="{StaticResource DialogButton}" Background="{DynamicResource RaisedBg}" Foreground="{DynamicResource TextPrimary}"/>
                <Button Content="OK" IsDefault="True" Click="SaveButton_Click"
                        Style="{StaticResource DialogButton}" Background="{DynamicResource Accent}" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
