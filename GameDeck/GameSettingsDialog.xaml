<Window x:Class="GameDeck.Views.GameSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit game" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#171A21"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="Edit game" Foreground="White" FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Text="Name" Foreground="#C5CBD6" FontSize="13" Margin="0,18,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}"/>

        <TextBlock Text="Categories" Foreground="#C5CBD6" FontSize="13" Margin="0,16,0,6"/>
        <TextBox x:Name="TagsBox" Style="{StaticResource DarkTextBox}"/>
        <TextBlock Text="Separate them with commas, for example: Co-op, Racing" Foreground="#6F7685" FontSize="12"
                   Margin="0,5,0,0"/>

        <TextBlock Text="Launch options" Foreground="#C5CBD6" FontSize="13" Margin="0,16,0,6"/>
        <TextBox x:Name="ArgsBox" Style="{StaticResource DarkTextBox}"/>
        <CheckBox x:Name="AdminCheckBox" Style="{StaticResource DarkCheckBox}" Content="Run as administrator"
                  Margin="0,12,0,0"/>
        <TextBlock x:Name="LaunchHint" Foreground="#6F7685" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True"
                    Style="{StaticResource DialogButton}" Background="#2A2F3A" Foreground="White"/>
            <Button Content="Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogButton}" Background="#8037FE" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
