<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!--
			Off on purpose: with compression Windows has to unpack every program file into private memory when the app
			starts (measured: ~145 MB vs ~81 MB). Uncompressed, the files are read straight from the .exe on demand.
			The price is a bigger .exe on disk (~165 MB instead of ~72 MB).
		-->
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
		<DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
		<OutputType>WinExe</OutputType>
		<!--
			The Windows 10 SDK part (10.0.19041) gives access to Windows' modern APIs (WinRT): Windows.Gaming.Input reads the
			battery of Xbox controllers over Bluetooth. The app still runs on Windows 10 1809 and later (SupportedOSPlatformVersion).
		-->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- WinForms is only here for the system tray icon (NotifyIcon) -->
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
		<!-- 32-bit (win-x86) and 64-bit (win-x64) builds: see publish.ps1 -->
		<RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
		<Version>1.4.0</Version>
		<!-- a desktop app doesn't need a background garbage-collector thread or extra JIT profiling memory -->
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<TieredPGO>false</TieredPGO>
	</PropertyGroup>

	<!-- The Beta (see beta.ps1): the same code with another name and identity (AppInfo.cs), built with -p:GameDeckBeta=true -->
	<PropertyGroup Condition="'$(GameDeckBeta)' == 'true'">
		<DefineConstants>$(DefineConstants);BETA</DefineConstants>
		<AssemblyName>GameDeckBeta</AssemblyName>
		<!-- the Beta has its own icon: the program file, the taskbar, the window and the tray -->
		<ApplicationIcon>Assets\beta-icon.ico</ApplicationIcon>
		<RootNamespace>GameDeck</RootNamespace>
		<!-- its own build folder: the generated files carry the program's name, and must not be mixed with the normal build's -->
		<IntermediateOutputPath>obj\beta\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- keeps WinForms' type names (MessageBox, Application, ...) from clashing with WPF's -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<!-- SDL2: reads Xbox, PlayStation (DualShock 4 / DualSense) and Nintendo Switch Pro controllers; only loaded while Big Picture mode is open -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
		<PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\icon.ico" />
	</ItemGroup>

	<ItemGroup Condition="'$(GameDeckBeta)' == 'true'">
		<Resource Include="Assets\beta-icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- the tests in GameDeck.Tests use the helpers that are marked internal -->
		<InternalsVisibleTo Include="GameDeck.Tests" />
	</ItemGroup>

	<!--
		One Publish = both versions. Whichever of win-x86 / win-x64 is being published (any publish profile, the
		Publish button in Visual Studio, or "dotnet publish"), the other one is published right after it, from the
		same code, into the sibling folder: ...\publish\win-x86\ and ...\publish\win-x64\.
	-->
	<Target Name="PublishOtherArchitecture" AfterTargets="Publish" Condition="'$(GameDeckInnerPublish)' != 'true' And ('$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64')">
		<PropertyGroup>
			<_OtherRid Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x64</_OtherRid>
			<_OtherRid Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x86</_OtherRid>
			<_OtherPublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\publish\$(_OtherRid)\</_OtherPublishDir>
		</PropertyGroup>

		<Message Importance="high" Text="Also publishing $(_OtherRid) -&gt; $(_OtherPublishDir)" />

		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="GameDeckInnerPublish=true;RuntimeIdentifier=$(_OtherRid);SelfContained=$(SelfContained);PublishDir=$(_OtherPublishDir)" />
	</Target>

</Project>