<Window x:Class="GameDeck.Views.QuickLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDeck quick launch" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="QuickItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RaisedBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8037FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- the margin leaves room for the shadow, which the transparent window would otherwise clip -->
    <Border Margin="14" Background="{DynamicResource AppBg}" CornerRadius="10" BorderBrush="{DynamicResource RaisedBg}" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" FontSize="18" Padding="12,10"
                     TextChanged="SearchBox_TextChanged"/>

            <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                     ItemContainerStyle="{StaticResource QuickItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SourceText}" Foreground="{DynamicResource TextSecondary}" Opacity="0.7"
                                       FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Text="No games found." Foreground="{DynamicResource TextMuted}" FontSize="14"
                       Margin="12,12,0,6" Visibility="Collapsed"/>
            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextHint}" FontSize="12" Margin="4,10,0,0"
                       Text="Enter to launch  ·  ↑ ↓ to choose  ·  Esc to close"/>
        </StackPanel>
    </Border>
</Window>
