<UserControl x:Class="GameDeck.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- big blue "Play" button -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="44,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8AD0F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="PageScroll_ScrollChanged">
        <StackPanel x:Name="PageRoot" Margin="8,0,8,0" MaxWidth="900" HorizontalAlignment="Left">

            <!-- back button -->
            <Button Style="{StaticResource PillButton}" Margin="0,0,0,22" Padding="14,8"
                    HorizontalAlignment="Left" Content="←  Library" FontSize="14"
                    Click="BackButton_Click" ToolTip="Back to the library (Esc)"/>

            <!-- narrow: one column (the screenshots, history and sessions under the rest); wide: those in a column of their
                 own on the right (UpdateLayoutMode moves SidePanel) -->
            <Grid x:Name="PageGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GapColumn" Width="0"/>
                    <ColumnDefinition x:Name="SideColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cover (2:3 poster) -->
                <Border Grid.RowSpan="2" Width="200" Height="300" CornerRadius="6" Margin="0,0,32,0" VerticalAlignment="Top"
                        Background="{Binding PlaceholderBrush}">
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,200,300" RadiusX="6" RadiusY="6"/>
                        </Grid.Clip>
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="14"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="InfoPanel" Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="32" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,4,0,0"/>

                    <Button x:Name="PlayButton" Content="▶  Play" Style="{StaticResource PlayButton}"
                            HorizontalAlignment="Left" Margin="0,22,0,0" Click="PlayButton_Click"/>

                    <TextBlock Text="YOUR STATS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                               Margin="2,30,0,10"/>
                    <WrapPanel>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170">
                            <StackPanel>
                                <TextBlock Text="{Binding PlaytimeText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="time played" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170">
                            <StackPanel>
                                <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="last played" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170">
                            <StackPanel>
                                <TextBlock x:Name="RankText" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="most played rank" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- from Steam's (or GOG Galaxy's) files on this PC: only when they say -->
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170"
                                Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding AchievementsText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="achievements" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- the install folder's size (DiskUsage): only once it is known -->
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="22,16" Margin="0,0,14,14" MinWidth="170"
                                Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="on disk" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- the rating: five stars to click (GameDetailsView.xaml.cs › ShowRating) -->
                    <StackPanel x:Name="RatingStars" Orientation="Horizontal" Margin="0,10,0,0"/>

                    <TextBlock x:Name="CategoriesText" Foreground="{DynamicResource TextMuted}" FontSize="14" TextWrapping="Wrap"
                               Margin="2,4,0,0"/>
                    <TextBlock x:Name="GenresText" Foreground="{DynamicResource TextMuted}" FontSize="14" TextWrapping="Wrap"
                               Margin="2,4,0,0"/>
                    <!-- its DLC and soundtracks that Steam installed as apps of their own (kept out of the library) -->
                    <TextBlock x:Name="AddOnsText" Foreground="{DynamicResource TextMuted}" FontSize="14" TextWrapping="Wrap"
                               Margin="2,4,0,0"/>

                    <!-- "where I left off": written when the game was closed (or from its menu) -->
                    <StackPanel x:Name="LeftOffPanel" Margin="0,22,0,0">
                        <TextBlock x:Name="LeftOffHeader" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   Margin="2,0,0,10"/>
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="16,12" BorderThickness="3,0,0,0"
                                BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Left">
                            <TextBlock x:Name="LeftOffText" Foreground="{DynamicResource TextPrimary}" FontSize="15" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="NotesPanel" Margin="0,22,0,0">
                        <TextBlock Text="YOUR NOTES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   Margin="2,0,0,10"/>
                        <TextBlock x:Name="NotesText" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"
                                   Margin="2,0,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="ShotsPanel" Margin="0,22,0,0">
                        <DockPanel Margin="2,0,0,10">
                            <Button x:Name="AddShotsButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="12,6" FontSize="13"
                                    Content="＋  Add screenshots…" Click="AddShots_Click"/>
                            <TextBlock Text="SCREENSHOTS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel x:Name="ShotsWrap"/>
                        <TextBlock x:Name="ShotsHint" Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,0"
                                   Text="None yet. Game Bar captures (Win + Alt + PrtScn) of this game show up here by themselves, or add your own."/>
                    </StackPanel>
                </StackPanel>

                <!-- history and sessions: under the rest (narrow), or in the right-hand column (wide) -->
                <StackPanel x:Name="SidePanel" Grid.Column="1" Grid.Row="1">
                    <!-- play history: a square per day of the last weeks, darker the more was played (sessions from GameDeck) -->
                    <StackPanel x:Name="HistoryPanel" Margin="0,22,0,0">
                        <TextBlock Text="PLAY HISTORY" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   Margin="2,0,0,10"/>
                        <TextBlock x:Name="HistorySummary" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap"
                                   Margin="2,0,0,12"/>
                        <Grid x:Name="HistoryGrid" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        <TextBlock x:Name="HistoryRange" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,8,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="SessionsPanel" Margin="0,22,0,0">
                        <TextBlock Text="RECENT SESSIONS" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   Margin="2,0,0,10"/>
                        <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource SessionRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
